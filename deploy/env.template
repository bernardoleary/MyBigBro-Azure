# ==============================================================================
# MyBigBro - Azure Deployment Configuration Overrides
# Copy this file to 'deploy/.env' to customize your deployment.
# ==============================================================================

# Target Azure Region (e.g., newzealandnorth, australiaeast, eastus, westeurope)
AZURE_LOCATION="newzealandnorth"

# Azure Resource Group Name
AZURE_RESOURCE_GROUP="rg-mybigbro"

# Deterministic 5-character suffix for globally unique resources (leave blank to auto-generate)
# RANDOM_SUFFIX="abc12"

# PostgreSQL Configuration
POSTGRES_DB="mybigbro"
POSTGRES_USER="mybigbro"
# POSTGRES_PASSWORD="YourStrongPassword123#!" # If left commented, a secure password is automatically generated

# Container image tag (default: latest)
IMAGE_TAG="latest"

# Set to "true" to skip building images if they are already published to ACR
SKIP_BUILD="false"

# Set to "true" to skip executing 01-init-schema.sql and 02-seed-webcams.sql
SKIP_DB_INIT="false"
